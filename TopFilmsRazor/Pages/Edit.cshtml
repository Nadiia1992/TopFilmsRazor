@page
@model TopFilmsRazor.Pages.EditModel

@{
    ViewData["Title"] = "Редагування";
}

<h2>Редагування</h2>

<h6>Фільму</h6>
<h5>@Model.Film.Name</h5>
<hr />
<div class="cont-form">
    <div class="row">
        <div class="col-md-4 text-center">
            <img src="@Url.Content(Model.Film.Poster)" alt="@Model.Film.Name" class="delete-img" />
        </div>
        <div class="col-md-8">
            <form method="post" enctype="multipart/form-data">

                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <input type="hidden" asp-for="Film.Id" value="@Model.Film.Id" />

                <div class="mb-9">
                    <label asp-for="Film.Name" class="control-label"></label>
                    <input asp-for="Film.Name" class="form-control" />
                    <span asp-validation-for="Film.Name" class="text-danger"></span>
                </div>
                <div class="mb-9">
                    <label asp-for="Film.Director" class="control-label"></label>
                    <input asp-for="Film.Director" class="form-control" />
                    <span asp-validation-for="Film.Director" class="text-danger"></span>
                </div>
                <div class="mb-9">
                    <label asp-for="Film.Genre" class="control-label"></label>
                    <input asp-for="Film.Genre" class="form-control" />
                    <span asp-validation-for="Film.Genre" class="text-danger"></span>
                </div>
                <div class="mb-9">
                    <label asp-for="Film.Year" class="control-label"></label>
                    <input asp-for="Film.Year" class="form-control" />
                    <span asp-validation-for="Film.Year" class="text-danger"></span>
                </div>


                <div class="mb-9">
                    <label asp-for="Film.Poster" class="form-label fw-bold"></label>
                    <input asp-for="posterFile" class="form-control" type="file" accept="image/png, image/jpeg" placeholder="Введіть постер" />
                    <span asp-validation-for="Film.Poster" class="text-danger"></span>
                </div>


                <div class="mb-9">
                    <label asp-for="Film.Info" class="control-label"></label>
                    <textarea asp-for="Film.Info" class="form-control " rows="7"></textarea>
                    <span asp-validation-for="Film.Info" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <input type="submit" value="Зберегти" class="btn btn-primary" />
                    <a asp-page="Index" class="btn btn-secondary ms-2">Повернутися до списку</a>
                </div>
            </form>
        </div>
    </div>
</div>
@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}

@page
@model TopFilmsRazor.Pages.IndexModel
@{
    ViewData["Title"] = "Топ 10 фільмів";
}

<div class="d-flex justify-content-between align-items-center mb-3">

    <a asp-page="Create" class="btn btn-success shadow-sm">+ Додати фільм</a>
</div>

<div class="card">
    <div class="card-body">
        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-4 g-4">

            @foreach (var item in Model.Films)
            {
                <div class="col">
                    <div class="card h-100 shadow-sm border-0">
                        <div class="card-body d-flex flex-column">
                            <img class="foto" src="@item.Poster" alt="@item.Name" />
                            <h3 class="align-middle">@Html.DisplayFor(modelItem => item.Name)</h3>
                            <p class="align-middle">@Html.DisplayFor(modelItem => item.Director)</p>
                            <p class="align-middle">@Html.DisplayFor(modelItem => item.Genre)</p>
                            <h4 class="align-middle">
                                <span class="badge bg-info text-dark fs-6">@Html.DisplayFor(modelItem => item.Year)</span>
                            </h4>
                            <p class="text-end align-middle">
                                <a asp-page="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Редагувати</a>
                                <a asp-page="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">Деталі</a>
                                <a asp-page="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">Видалити</a>
                            </p>
                        </div>
                    </div>


                </div>
            }
        </div>
    </div>
</div>